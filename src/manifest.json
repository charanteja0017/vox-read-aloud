{
  "manifest_version": 3,
  "name": "Vox — Natural Read Aloud",
  "version": "1.0.0",
  "description": "Reads any page aloud with a natural AI voice that runs entirely on your device. No cloud, no robotic speech.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/charanteja0017/vox-read-aloud",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "contextMenus"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Vox — Read Aloud",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "read-aloud": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Read selection (or whole page) aloud"
    },
    "play-pause": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Play / Pause"
    },
    "stop": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Stop reading"
    },
    "next-sentence": {
      "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" },
      "description": "Skip to next sentence"
    },
    "prev-sentence": {
      "description": "Back to previous sentence (assign a key in chrome://extensions/shortcuts)"
    },
    "speed-up": {
      "description": "Speak faster"
    },
    "speed-down": {
      "description": "Speak slower"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["voices/*.bin"],
      "matches": ["<all_urls>"]
    }
  ]
}
